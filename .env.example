# Copy this file to .env and fill in real values.
# Never commit .env — it is already in .gitignore.

# ---- Airtable ----
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_VIDEOS_TABLE=Videos
AIRTABLE_MEDIA_ASSETS_TABLE=Media Assets
AIRTABLE_ERRORS_TABLE=Errors
AIRTABLE_SHORTS_TABLE=Shorts

# ---- Topic mode ----
# manual: operator types a title (Phase 1). discovery: opportunity-engine-selected topics (not implemented yet).
TOPIC_MODE=manual

# ---- LLM provider ----
# Which provider config/providers.json "llm.default" should use at runtime.
# Options: gemini | openai | anthropic | ollama | mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- Voice (TTS) ----
# Options: edge-tts | piper | kokoro | elevenlabs (edge-tts and elevenlabs are implemented).
# This is only the *default* -- a job can request a different provider via
# its "Voice Provider" Airtable field regardless of what's set here.
TTS_PROVIDER=edge-tts
ELEVENLABS_API_KEY=

# ---- Stock assets ----
PEXELS_API_KEY=
PIXABAY_API_KEY=

# AI image/video generation -- opt-in only. Used only when a job's "AI Image
# Usage"/"AI Video Usage" checkbox is on AND Pexels/Pixabay search comes up
# empty for that scene; never used by default. API shape unverified against
# Higgsfield's real docs -- see services/assets/higgsfield.ts.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE_URL=https://api.higgsfield.ai/v1

# ---- Rendering ----
# Options: remotion | ffmpeg | json2video
RENDER_PROVIDER=remotion
JSON2VIDEO_API_KEY=

# ---- Storage ----
# Options: local | google_drive | r2 | s3 (only local is implemented)
STORAGE_PROVIDER=local

# ---- Social repurposing (opt-in only, Update 12) ----
# Never runs automatically -- only used by n8n/14-social-repurpose.json,
# which you trigger manually per Published video. API shape unverified
# against Blotato's real docs -- see services/social/blotato.ts.
BLOTATO_API_KEY=
BLOTATO_API_BASE_URL=https://backend.blotato.com/v2

# ---- YouTube (Data API v3) ----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---- Worker service ----
WORKER_PORT=4000
DATA_DIR=./data

# ---- Cost controls ----
FREE_MODE=true
PREMIUM_MODE=false
