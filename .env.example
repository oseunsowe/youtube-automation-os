# Copy this file to .env and fill in real values.
# Never commit .env — it is already in .gitignore.

# ---- Airtable ----
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_VIDEOS_TABLE=Videos
AIRTABLE_MEDIA_ASSETS_TABLE=Media Assets
AIRTABLE_ERRORS_TABLE=Errors

# ---- Topic mode ----
# manual: operator types a title (Phase 1). discovery: opportunity-engine-selected topics (not implemented yet).
TOPIC_MODE=manual

# ---- LLM provider ----
# Which provider config/providers.json "llm.default" should use at runtime.
# Options: gemini | openai | anthropic | ollama | mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---- Voice (TTS) ----
# Options: edge-tts | piper | kokoro | elevenlabs (only edge-tts is implemented)
TTS_PROVIDER=edge-tts

# ---- Stock assets ----
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Rendering ----
# Options: remotion | ffmpeg | json2video
RENDER_PROVIDER=remotion
JSON2VIDEO_API_KEY=

# ---- Storage ----
# Options: local | google_drive | r2 | s3 (only local is implemented)
STORAGE_PROVIDER=local

# ---- YouTube (Data API v3) ----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---- Worker service ----
WORKER_PORT=4000
DATA_DIR=./data

# ---- Cost controls ----
FREE_MODE=true
PREMIUM_MODE=false
