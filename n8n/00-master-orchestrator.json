{
  "name": "00 - Master Orchestrator",
  "nodes": [
    {
      "id": "n1-schedule",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1600, 0],
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 1 }] }
      }
    },
    {
      "id": "n2-find-jobs",
      "name": "Find Jobs (Status=Start)",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [-1360, 0],
      "parameters": {
        "authentication": "airtableTokenApi",
        "operation": "search",
        "base": { "__rl": true, "mode": "id", "value": "REPLACE_WITH_YOUR_BASE_ID" },
        "table": { "__rl": true, "mode": "name", "value": "Videos" },
        "filterByFormula": "={Status}='Start'",
        "options": {}
      },
      "credentials": { "airtableTokenApi": { "id": "REPLACE", "name": "Airtable account" } }
    },
    {
      "id": "n3-loop",
      "name": "Loop Over Jobs",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [-1120, 0],
      "parameters": { "batchSize": 1, "options": {} }
    },
    {
      "id": "n4-job-vars",
      "name": "Build Job Vars",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-880, -120],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "name": "videoId", "type": "string", "value": "={{ $json.id }}" },
            { "name": "title", "type": "string", "value": "={{ $json.fields.Title }}" },
            { "name": "category", "type": "string", "value": "={{ $json.fields.Category }}" },
            { "name": "runtimeMinutes", "type": "number", "value": "={{ $json.fields['Default Runtime'] || 5 }}" },
            { "name": "voice", "type": "string", "value": "={{ $json.fields.Voice || 'en-US-AndrewNeural' }}" }
          ]
        }
      }
    },
    {
      "id": "n5-script",
      "name": "Generate Script",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-640, -120],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "http://worker:4000/script/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $json.title, category: $json.category, runtimeMinutes: $json.runtimeMinutes }) }}",
        "options": {}
      }
    },
    {
      "id": "n6-scenes",
      "name": "Build Scenes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-400, -120],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "http://worker:4000/scenes/build",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ script: $json.script }) }}",
        "options": {}
      }
    },
    {
      "id": "n7-assets",
      "name": "Attach Assets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-160, -120],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "http://worker:4000/assets/attach",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ videoId: $('Build Job Vars').item.json.videoId, scenes: $json.scenes }) }}",
        "options": {}
      }
    },
    {
      "id": "n8-status-narrating",
      "name": "Set Status: Narrating",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [80, -120],
      "parameters": {
        "authentication": "airtableTokenApi",
        "operation": "update",
        "base": { "__rl": true, "mode": "id", "value": "REPLACE_WITH_YOUR_BASE_ID" },
        "table": { "__rl": true, "mode": "name", "value": "Videos" },
        "columns": {
          "value": {
            "id": "={{ $('Build Job Vars').item.json.videoId }}",
            "Status": "Narrating",
            "Scene Count": "={{ $json.scenes.length }}"
          }
        },
        "options": {}
      },
      "credentials": { "airtableTokenApi": { "id": "REPLACE", "name": "Airtable account" } }
    },
    {
      "id": "n9-voice",
      "name": "Generate Voice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [320, -120],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "http://worker:4000/voice/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ videoId: $('Build Job Vars').item.json.videoId, scenes: $json.scenes, voice: $('Build Job Vars').item.json.voice }) }}",
        "options": {}
      }
    },
    {
      "id": "n10-status-rendering",
      "name": "Set Status: Rendering",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [560, -120],
      "parameters": {
        "authentication": "airtableTokenApi",
        "operation": "update",
        "base": { "__rl": true, "mode": "id", "value": "REPLACE_WITH_YOUR_BASE_ID" },
        "table": { "__rl": true, "mode": "name", "value": "Videos" },
        "columns": {
          "value": { "id": "={{ $('Build Job Vars').item.json.videoId }}", "Status": "Rendering" }
        },
        "options": {}
      },
      "credentials": { "airtableTokenApi": { "id": "REPLACE", "name": "Airtable account" } }
    },
    {
      "id": "n11-render",
      "name": "Render Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, -120],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "http://worker:4000/render",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ videoId: $('Build Job Vars').item.json.videoId, scenes: $json.scenes, engine: 'remotion' }) }}",
        "options": { "timeout": 1800000 }
      }
    },
    {
      "id": "n12-status-ready",
      "name": "Set Status: Ready to Publish",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1040, -120],
      "parameters": {
        "authentication": "airtableTokenApi",
        "operation": "update",
        "base": { "__rl": true, "mode": "id", "value": "REPLACE_WITH_YOUR_BASE_ID" },
        "table": { "__rl": true, "mode": "name", "value": "Videos" },
        "columns": {
          "value": {
            "id": "={{ $('Build Job Vars').item.json.videoId }}",
            "Status": "Ready to Publish",
            "Render URL/Path": "={{ $json.outPath }}"
          }
        },
        "options": {}
      },
      "credentials": { "airtableTokenApi": { "id": "REPLACE", "name": "Airtable account" } }
    },
    {
      "id": "n13-upload",
      "name": "Upload To YouTube",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1280, -120],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "http://worker:4000/youtube/upload",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filePath: $json['Render URL/Path'] || $json.outPath, title: $('Build Job Vars').item.json.title, description: '', privacyStatus: 'private' }) }}",
        "options": { "timeout": 1800000 }
      }
    },
    {
      "id": "n14-status-published",
      "name": "Set Status: Published",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1520, -220],
      "parameters": {
        "authentication": "airtableTokenApi",
        "operation": "update",
        "base": { "__rl": true, "mode": "id", "value": "REPLACE_WITH_YOUR_BASE_ID" },
        "table": { "__rl": true, "mode": "name", "value": "Videos" },
        "columns": {
          "value": {
            "id": "={{ $('Build Job Vars').item.json.videoId }}",
            "Status": "Published",
            "YouTube ID": "={{ $json.youtubeId }}",
            "Published At": "={{ $now.toISO() }}"
          }
        },
        "options": {}
      },
      "credentials": { "airtableTokenApi": { "id": "REPLACE", "name": "Airtable account" } }
    },
    {
      "id": "n15-error-fields",
      "name": "Build Error Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [80, 220],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "name": "message", "type": "string", "value": "={{ $json.error || $json.message || 'Unknown error' }}" }
          ]
        }
      }
    },
    {
      "id": "n16-mark-failed",
      "name": "Set Status: Failed",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [320, 220],
      "parameters": {
        "authentication": "airtableTokenApi",
        "operation": "update",
        "base": { "__rl": true, "mode": "id", "value": "REPLACE_WITH_YOUR_BASE_ID" },
        "table": { "__rl": true, "mode": "name", "value": "Videos" },
        "columns": {
          "value": { "id": "={{ $('Build Job Vars').item.json.videoId }}", "Status": "Failed" }
        },
        "options": {}
      },
      "credentials": { "airtableTokenApi": { "id": "REPLACE", "name": "Airtable account" } }
    },
    {
      "id": "n17-log-error",
      "name": "Log Error Record",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [560, 220],
      "parameters": {
        "authentication": "airtableTokenApi",
        "operation": "create",
        "base": { "__rl": true, "mode": "id", "value": "REPLACE_WITH_YOUR_BASE_ID" },
        "table": { "__rl": true, "mode": "name", "value": "Errors" },
        "columns": {
          "value": {
            "Workflow": "00 - Master Orchestrator",
            "Video/Record": "={{ $('Build Job Vars').item.json.videoId }}",
            "Message": "={{ $json.message }}",
            "Timestamp": "={{ $now.toISO() }}",
            "Resolved": false
          }
        },
        "options": {}
      },
      "credentials": { "airtableTokenApi": { "id": "REPLACE", "name": "Airtable account" } }
    }
  ],
  "connections": {
    "Every Minute": { "main": [[{ "node": "Find Jobs (Status=Start)", "type": "main", "index": 0 }]] },
    "Find Jobs (Status=Start)": { "main": [[{ "node": "Loop Over Jobs", "type": "main", "index": 0 }]] },
    "Loop Over Jobs": { "main": [[], [{ "node": "Build Job Vars", "type": "main", "index": 0 }]] },
    "Build Job Vars": { "main": [[{ "node": "Generate Script", "type": "main", "index": 0 }]] },
    "Generate Script": {
      "main": [
        [{ "node": "Build Scenes", "type": "main", "index": 0 }],
        [{ "node": "Build Error Fields", "type": "main", "index": 0 }]
      ]
    },
    "Build Scenes": {
      "main": [
        [{ "node": "Attach Assets", "type": "main", "index": 0 }],
        [{ "node": "Build Error Fields", "type": "main", "index": 0 }]
      ]
    },
    "Attach Assets": {
      "main": [
        [{ "node": "Set Status: Narrating", "type": "main", "index": 0 }],
        [{ "node": "Build Error Fields", "type": "main", "index": 0 }]
      ]
    },
    "Set Status: Narrating": { "main": [[{ "node": "Generate Voice", "type": "main", "index": 0 }]] },
    "Generate Voice": {
      "main": [
        [{ "node": "Set Status: Rendering", "type": "main", "index": 0 }],
        [{ "node": "Build Error Fields", "type": "main", "index": 0 }]
      ]
    },
    "Set Status: Rendering": { "main": [[{ "node": "Render Video", "type": "main", "index": 0 }]] },
    "Render Video": {
      "main": [
        [{ "node": "Set Status: Ready to Publish", "type": "main", "index": 0 }],
        [{ "node": "Build Error Fields", "type": "main", "index": 0 }]
      ]
    },
    "Set Status: Ready to Publish": { "main": [[{ "node": "Upload To YouTube", "type": "main", "index": 0 }]] },
    "Upload To YouTube": {
      "main": [
        [{ "node": "Set Status: Published", "type": "main", "index": 0 }],
        [{ "node": "Build Error Fields", "type": "main", "index": 0 }]
      ]
    },
    "Set Status: Published": { "main": [[{ "node": "Loop Over Jobs", "type": "main", "index": 0 }]] },
    "Build Error Fields": { "main": [[{ "node": "Set Status: Failed", "type": "main", "index": 0 }]] },
    "Set Status: Failed": { "main": [[{ "node": "Log Error Record", "type": "main", "index": 0 }]] },
    "Log Error Record": { "main": [[{ "node": "Loop Over Jobs", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
