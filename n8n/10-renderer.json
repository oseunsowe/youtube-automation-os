{
  "name": "10 - Renderer (standalone test)",
  "nodes": [
    {
      "id": "d1-manual",
      "name": "Manual Test",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-600, 0],
      "parameters": {}
    },
    {
      "id": "d2-sample",
      "name": "Sample Scenes",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-360, 0],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            { "name": "videoId", "type": "string", "value": "rec_sample" },
            { "name": "engine", "type": "string", "value": "remotion" },
            {
              "name": "scenes",
              "type": "array",
              "value": "={{ [ { id: 'scene-01', index: 0, narration: 'Something happened that no one saw coming.', durationSeconds: 5, visualType: 'title', audioPath: '/data/rec_sample/audio/scene-01.mp3' } ] }}"
            }
          ]
        }
      }
    },
    {
      "id": "d3-http",
      "name": "Render Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-120, 0],
      "parameters": {
        "method": "POST",
        "url": "http://worker:4000/render",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ videoId: $json.videoId, scenes: $json.scenes, engine: $json.engine }) }}",
        "options": { "timeout": 1800000 }
      }
    }
  ],
  "connections": {
    "Manual Test": { "main": [[{ "node": "Sample Scenes", "type": "main", "index": 0 }]] },
    "Sample Scenes": { "main": [[{ "node": "Render Video", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
